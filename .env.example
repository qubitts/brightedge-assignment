# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brightedge

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400

# Logging
LOG_LEVEL=INFO

# Classification: nlp | llm
CLASSIFICATION_MODE=nlp

# LLM Provider: openai | anthropic | gemini
LLM_PROVIDER=gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
